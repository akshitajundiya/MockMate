# Copy to .env and fill in (or export the variable in your shell)
GEMINI_API_KEY=your-key-here

# Optional overrides.
# Must be a Gemini 3.x model: the Planner and Evaluator rely on structured
# outputs, and the 2.5 family ignores the JSON schema and replies with prose.
# Verified working: gemini-3.6-flash, gemini-3.5-flash,
#                   gemini-3.5-flash-lite, gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.6-flash
# INTERVIEW_MIN_TURNS=5
# INTERVIEW_MAX_TURNS=7
# INTERVIEW_MAX_RETRIES=5
